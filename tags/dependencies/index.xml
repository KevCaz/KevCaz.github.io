&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#d7827e"&gt;R&lt;/span&gt;&lt;span style="color:#797593"&gt;&amp;gt;&lt;/span&gt; &lt;span style="color:#d7827e"&gt;ap&lt;/span&gt; &lt;span style="color:#797593"&gt;&amp;lt;-&lt;/span&gt; &lt;span style="color:#d7827e"&gt;available.packages&lt;/span&gt;&lt;span style="color:#797593"&gt;()&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#d7827e"&gt;R&lt;/span&gt;&lt;span style="color:#797593"&gt;&amp;gt;&lt;/span&gt; &lt;span style="color:#d7827e"&gt;nrow&lt;/span&gt;&lt;span style="color:#797593"&gt;(&lt;/span&gt;&lt;span style="color:#d7827e"&gt;ap&lt;/span&gt;&lt;span style="color:#797593"&gt;)&lt;/span&gt; &lt;span style="color:#9893a5"&gt;# nb available package&lt;/span&gt;
